# MSSQL Connection (existing Docker mssql container)
DATABASE_URL="sqlserver://mssql:1433;database=pmam;user=sa;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# JWT Secrets
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ntfy integration (optional, points to existing ntfy container on docker network 'web')
NTFY_URL="http://ntfy"

# Ports
PORT=4000
WEB_PORT=3600
